# --- Firebase (client, safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only, from a service account JSON downloaded in
# Firebase Console > Project settings > Service accounts > Generate new private key) ---
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Paste the private key with literal \n for newlines, wrapped in quotes
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Google Sheets + Slides ---
# No separate service account needed: this reuses the FIREBASE_ADMIN_* creds
# above (same Google Cloud project). You just need to:
#   1. Enable the Google Sheets API and Google Slides API for this project at
#      console.cloud.google.com/apis/library (search each, click Enable)
#   2. Share the Sheet and the Slides deck with FIREBASE_ADMIN_CLIENT_EMAIL
#      as Viewer
GOOGLE_SHEETS_SPREADSHEET_ID=1wghoryB83b_wFc9cA96Cm68Zv3PpnuwNHTJMxxiu8LM
GOOGLE_SHEETS_COC_POINTS_TAB="COC-Points (Since 21st July 2026)"
# The "Code of Conduct" page reads this tab, in the same spreadsheet above.
GOOGLE_SHEETS_MASTER_TAB=Master
# The Penalty Points page's Slides deck. ID is the string in the URL between
# /presentation/d/ and /edit. (Content is also merged with static entries in
# src/lib/policy/static-tables.ts.)
GOOGLE_SLIDES_PRESENTATION_ID=1yMJoNwQzBYj6qHYae_HOAmL9wjNCHTGYzDBlzlHYn9c

# --- Admin allowlist ---
# Comma-separated emails allowed to sign in as Admin (belt-and-suspenders on
# top of the Firestore role check)
ADMIN_EMAIL_ALLOWLIST=

# --- Sign-up email domain restriction ---
# New admin/employee accounts must sign up with an email on this domain.
# Existing accounts signing in are unaffected. Defaults to orangehealth.in.
ALLOWED_EMAIL_DOMAIN=orangehealth.in
